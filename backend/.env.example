APP_NAME=Music For Art API
APP_ENV=dev
API_PREFIX=/api
DATABASE_URL=sqlite:///./music_for_art.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100
REPORT_MODE_DEFAULT=production

# LLM (OpenAI-compatible; DeepSeek recommended for CN users)
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SEC=120
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2600

# Semantic backend
SEMANTIC_BACKEND=local
SEMANTIC_NEO4J_DEPTH=2
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Rollout + cache
SEMANTIC_ROLLOUT_MODE=fixed
SEMANTIC_ROLLOUT_PERCENT=20
SEMANTIC_HYBRID_PROJECT_IDS=
REASON_CACHE_TTL_SEC=900
